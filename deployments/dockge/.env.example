COMPOSE_PROJECT_NAME=argws-scheduler-pro
RESOURCE_PREFIX=scheduler-pro
APP_TIMEZONE=America/Bahia
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=wkarts/scheduler-pro-platform
APP_IMAGE_TAG=latest
APP_BIND_HOST=127.0.0.1
APP_PORT=18080
SCHEDULER_PRO_DATA_ROOT=./scheduler-pro-data

APP_NAME=Scheduler Pro
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=troque-por-uma-chave-aleatoria-com-no-minimo-64-caracteres
PUBLIC_PLATFORM_DOMAIN=scheduler.argws.com.br
PUBLIC_BASE_URL=https://scheduler.argws.com.br
ADMIN_PLATFORM_DOMAINS=admin.scheduler.argws.com.br,api.scheduler.argws.com.br
TENANT_DEFAULT_DOMAIN_ROOT=scheduler.argws.com.br
CORS_ALLOWED_ORIGINS=https://scheduler.argws.com.br,https://admin.scheduler.argws.com.br,https://api.scheduler.argws.com.br,tauri://localhost,http://tauri.localhost,https://tauri.localhost,capacitor://localhost,ionic://localhost

POSTGRES_DB=platform
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=troque-por-uma-senha-postgres-sem-espacos
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=troque-por-uma-senha-admin-postgres-sem-espacos
RABBITMQ_USER=scheduler
RABBITMQ_PASSWORD=troque-por-uma-senha-rabbitmq-sem-espacos
S3_ACCESS_KEY=scheduler
S3_SECRET_KEY=troque-por-uma-senha-minio-sem-espacos
S3_REGION=sa-east-1
S3_PUBLIC_BUCKET=scheduler-public

CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DRY_RUN=false
CLOUDFLARE_CUSTOM_HOSTNAME_ORIGIN=proxy.scheduler.argws.com.br
CLOUDFLARE_TEMPORARY_RECORD_TYPE=CNAME
CLOUDFLARE_TEMPORARY_RECORD_TARGET=proxy.scheduler.argws.com.br

WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=
EVOLUTION_API_TOKEN=
EVOLUTION_INSTANCE_NAME=scheduler-pro

GITHUB_ACTIONS_API_BASE_URL=https://api.github.com
GITHUB_ACTIONS_REPOSITORY=wkarts/scheduler-pro-platform
GITHUB_ACTIONS_TOKEN=

LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
STORAGE_INIT_IMAGE=alpine:3.22
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:8-alpine
RABBITMQ_IMAGE=rabbitmq:4-management-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z

# Resiliência: limites POR PROCESSO. Não aumentar sem somar réplicas e workers.
DB_SERVICE_NAME=scheduler-api
DB_PLATFORM_POOL_SIZE=4
DB_PLATFORM_MAX_OVERFLOW=2
DB_TENANT_POOL_SIZE=1
DB_TENANT_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=3
DB_CONNECT_TIMEOUT_SECONDS=3
DB_POOL_RECYCLE_SECONDS=600
DB_CONNECTION_BUDGET_PER_PROCESS=24
TENANT_ENGINE_CACHE_MAX=8
TENANT_ENGINE_CACHE_TTL_SECONDS=120
DB_STATEMENT_TIMEOUT_MS=0
DB_LOCK_TIMEOUT_MS=0
DB_IDLE_TRANSACTION_TIMEOUT_MS=0
HEALTH_PROBE_TIMEOUT_SECONDS=3
HEALTH_CACHE_SECONDS=5
DB_CAPACITY_WARNING_PERCENT=75
DB_CAPACITY_CRITICAL_PERCENT=90
HTTP_LOG_MAX_PENDING=64
HTTP_LOG_CONCURRENCY=2
HTTP_LOG_TIMEOUT_SECONDS=3
API_MAX_INFLIGHT_REQUESTS=64

# Overrides dos workers: 2 + 2 processos; até 5 conexões em cada processo.
DB_WORKER_PLATFORM_POOL_SIZE=1
DB_WORKER_PLATFORM_MAX_OVERFLOW=0
DB_WORKER_TENANT_POOL_SIZE=1
DB_WORKER_TENANT_MAX_OVERFLOW=0
DB_WORKER_TENANT_ENGINE_CACHE_MAX=4
DB_WORKER_CONNECTION_BUDGET_PER_PROCESS=8
CELERY_DEFAULT_CONCURRENCY=2
CELERY_WHATSAPP_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=500
# Timeouts SQL permanecem opt-in para não cancelar relatórios/migrations existentes.
# Defaults: API 22 + workers 20 = 42 conexões potenciais de pools;
# contabilizar à parte probes, provisionamento direto, CLI, deploy e réplicas.
