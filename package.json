{
  "name": "scheduler-pro-platform",
  "private": true,
  "version": "0.1.0-alpha.1",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/web",
    "apps/admin",
    "apps/desktop",
    "apps/mobile",
    "apps/admin-desktop",
    "apps/admin-mobile",
    "packages/api-client",
    "packages/types",
    "packages/visual-builder"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "dev:desktop": "npm --workspace apps/desktop run tauri:dev",
    "dev:mobile": "npm --workspace apps/mobile run dev",
    "dev:admin-desktop": "npm --workspace apps/admin-desktop run tauri:dev",
    "dev:admin-mobile": "npm --workspace apps/admin-mobile run dev"
  },
  "engines": { "node": ">=22" },
  "overrides": { "typescript": "5.5.4", "vue-tsc": "2.1.10", "tailwindcss": "3.4.17" }
}
