{
  "name": "@argws/visual-builder",
  "version": "2.1.0",
  "description": "ARGWS Visual Builder Editor canônico 2.1.0 para o Scheduler Pro.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.js" },
    "./styles.css": "./runtime/package/styles/builder.css"
  },
  "files": ["src", "release-b64", "runtime", "scripts", "LICENSE", "README.md"],
  "scripts": {
    "materialize": "node scripts/materialize-release.mjs",
    "test": "npm run check",
    "check": "npm run materialize && node --check src/index.js && node --check runtime/package/src/index.js && node --check runtime/package/src/template-packages.js",
    "typecheck": "npm run check",
    "build": "npm run check"
  },
  "keywords": ["page-builder", "landing-page", "visual-editor", "responsive", "scheduler-pro", "argws"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "private": true
}
