{
  "name": "@argws/visual-builder",
  "version": "2.0.1",
  "description": "Registry oficial de versões do ARGWS Visual Builder Editor para o Scheduler Pro.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.js" },
    "./styles.css": "./styles/builder.css"
  },
  "files": ["src", "styles", "release-b64", "scripts", "LICENSE", "README.md"],
  "scripts": {
    "materialize": "node scripts/materialize-releases.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js",
    "typecheck": "npm run check",
    "build": "npm run materialize && npm run check"
  },
  "keywords": ["page-builder", "landing-page", "visual-editor", "scheduler-pro", "argws"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "private": true
}
