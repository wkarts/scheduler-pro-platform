{
  "name": "@argws/visual-builder",
  "version": "2.0.1",
  "description": "Registry oficial de versões do ARGWS Visual Builder Editor para o Scheduler Pro.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.js" },
    "./styles.css": "./styles/builder.css"
  },
  "files": ["src", "styles", "releases", "LICENSE", "README.md"],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js",
    "typecheck": "npm run check",
    "build": "npm run check"
  },
  "dependencies": {
    "@argws/visual-builder-v1": "file:./releases/argws-visual-builder-1.0.0.tgz",
    "@argws/visual-builder-v2": "file:./releases/argws-visual-builder-2.0.0.tgz",
    "@argws/visual-builder-v201": "file:./releases/argws-visual-builder-2.0.1.tgz"
  },
  "keywords": ["page-builder", "landing-page", "visual-editor", "scheduler-pro", "argws"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "private": true
