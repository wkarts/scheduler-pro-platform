    "dark": {
      "background": "#0B1020",
      "surface": "#121827",
      "elevated": "#1E2435",
      "text": "#F7F9FC",
      "muted": "#A6B2C4"
    }
  },
  "logos": {
    "light": "argws-visual-builder-logo-1600.png",
    "dark": "argws-visual-builder-logo-dark.png",
    "symbol": "argws-visual-builder-symbol-64.png"
  }
}
