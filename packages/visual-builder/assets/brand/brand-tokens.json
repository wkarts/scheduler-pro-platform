{
  "name": "ARGWS Visual Builder",
  "short_name": "AVB",
  "version": "2.3.2",
  "palette": {
    "deep_navy": "#0B1020",
    "charcoal": "#1E2435",
    "cyan": "#1AD5E8",
    "electric_blue": "#2563FF",
    "violet": "#7A4DFF",
    "light_gray": "#E9EEF5"
  },
  "gradient": "linear-gradient(90deg,#1AD5E8 0%,#2563FF 50%,#7A4DFF 100%)",
  "typography": {
    "heading": "Space Grotesk, Inter, ui-sans-serif, system-ui, sans-serif",
    "interface_body": "Inter, ui-sans-serif, system-ui, sans-serif",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "themes": {
    "light": {
      "background": "#F6F8FB",
      "surface": "#FFFFFF",
