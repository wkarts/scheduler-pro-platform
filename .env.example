POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=platform
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=troque-por-uma-senha-postgres
POSTGRES_ADMIN_USER=scheduler
POSTGRES_ADMIN_PASSWORD=

DEV_TENANT_DATABASE=tenant_dev
DEV_TENANT_DATABASE_USER=tenant_dev_user
DEV_TENANT_DATABASE_PASSWORD=tenant_dev_password
DEV_TENANT_DATABASE_PASSWORD_REF=secret://env/TENANT_DEV_DATABASE_PASSWORD
TENANT_DEV_DATABASE_PASSWORD=tenant_dev_password
DEV_TENANT_SLUG=dev
DEV_TENANT_NAME=Scheduler Pro Development
DEV_TENANT_BUCKET=tenant-dev
DEV_TENANT_ADMIN_EMAIL=admin@tenant.example
DEV_TENANT_ADMIN_PASSWORD=ChangeMe-Tenant-2026!
DEV_PLATFORM_ADMIN_EMAIL=admin@platform.example
DEV_PLATFORM_ADMIN_PASSWORD=ChangeMe-Platform-2026!

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MIN_LENGTH=12
TENANT_ENGINE_CACHE_MAX=8
TENANT_ENGINE_CACHE_TTL_SECONDS=120
TRUSTED_PROXY_HOSTS=127.0.0.1,::1

SMTP_HOST=smtp.seu-dominio.com.br
SMTP_PORT=587
SMTP_USERNAME=seu_usuario_smtp
SMTP_PASSWORD=sua_senha_smtp
SMTP_FROM_EMAIL=no-reply@seu-dominio.com.br
SMTP_FROM_NAME=Scheduler Pro
SMTP_REPLY_TO=suporte@seu-dominio.com.br
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://scheduler:scheduler@rabbitmq:5672//
CELERY_BROKER_URL=amqp://scheduler:scheduler@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=scheduler
S3_SECRET_KEY=troque-por-uma-senha-minio
S3_REGION=sa-east-1
S3_PUBLIC_BUCKET=scheduler-public

CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=argws.com.br
CLOUDFLARE_DRY_RUN=false
CLOUDFLARE_TEMPORARY_RECORD_TYPE=CNAME
CLOUDFLARE_TEMPORARY_RECORD_TARGET=proxy.scheduler.argws.com.br
CLOUDFLARE_TEMPORARY_RECORD_PROXIED=false
CLOUDFLARE_MANAGED_WILDCARD_DNS=true
CLOUDFLARE_MANAGED_WILDCARD_TARGET=proxy.scheduler.argws.com.br

TLS_PROVISIONING_MODE=local_acme
LOCAL_ACME_DOMAIN=scheduler.argws.com.br
LOCAL_ACME_CERT_DIR=/run/scheduler-pro-certs
ACME_EMAIL=admin@scheduler.argws.com.br
ACME_DOMAIN=scheduler.argws.com.br
ACME_STAGING=false
ACME_DNS_SLEEP=20
ACME_CHECK_INTERVAL_SECONDS=43200

CLOUDPANEL_SITE_DOMAIN=scheduler.argws.com.br
CLOUDPANEL_WILDCARD_DOMAIN=*.scheduler.argws.com.br
CLOUDPANEL_SYNC_INTERVAL_SECONDS=60

CLOUDFLARE_CUSTOM_HOSTNAME_ORIGIN=proxy.scheduler.argws.com.br
CLOUDFLARE_CUSTOM_HOSTNAME_CA=lets_encrypt

WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=
EVOLUTION_API_TOKEN=
EVOLUTION_INSTANCE_NAME=scheduler-pro

GITHUB_ACTIONS_API_BASE_URL=https://api.github.com
GITHUB_ACTIONS_REPOSITORY=wkarts/scheduler-pro-platform
GITHUB_ACTIONS_TOKEN=

CORS_ALLOWED_ORIGINS=https://scheduler.argws.com.br,https://admin.scheduler.argws.com.br,https://api.scheduler.argws.com.br,tauri://localhost,http://tauri.localhost,https://tauri.localhost,capacitor://localhost,ionic://localhost

# Resiliência: limites POR PROCESSO. Não aumentar sem somar réplicas e workers.
DB_SERVICE_NAME=scheduler-api
DB_PLATFORM_POOL_SIZE=4
DB_PLATFORM_MAX_OVERFLOW=2
DB_TENANT_POOL_SIZE=1
DB_TENANT_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=3
DB_CONNECT_TIMEOUT_SECONDS=3
DB_POOL_RECYCLE_SECONDS=600
DB_CONNECTION_BUDGET_PER_PROCESS=24
DB_STATEMENT_TIMEOUT_MS=0
DB_LOCK_TIMEOUT_MS=0
DB_IDLE_TRANSACTION_TIMEOUT_MS=0
HEALTH_PROBE_TIMEOUT_SECONDS=3
HEALTH_CACHE_SECONDS=5
DB_CAPACITY_WARNING_PERCENT=75
DB_CAPACITY_CRITICAL_PERCENT=90
HTTP_LOG_MAX_PENDING=64
HTTP_LOG_CONCURRENCY=2
HTTP_LOG_TIMEOUT_SECONDS=3
API_MAX_INFLIGHT_REQUESTS=64

# Overrides dos workers: 2 + 2 processos; até 5 conexões em cada processo.
DB_WORKER_PLATFORM_POOL_SIZE=1
DB_WORKER_PLATFORM_MAX_OVERFLOW=0
DB_WORKER_TENANT_POOL_SIZE=1
DB_WORKER_TENANT_MAX_OVERFLOW=0
DB_WORKER_TENANT_ENGINE_CACHE_MAX=4
DB_WORKER_CONNECTION_BUDGET_PER_PROCESS=8
CELERY_DEFAULT_CONCURRENCY=2
CELERY_WHATSAPP_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=500
# Timeouts SQL permanecem opt-in para não cancelar relatórios/migrations existentes.
# Defaults: API 22 + workers 20 + webhooks 3 = 45 conexões potenciais de pools;
# contabilizar à parte probes, provisionamento direto, CLI, deploy e réplicas.

# API Services / Webhook Services: isolated credentials; no global integration token.
INTEGRATION_API_ENABLED=true
INTEGRATION_WEBHOOKS_ENABLED=true
CELERY_WEBHOOK_CONCURRENCY=1

INTEGRATION_MAX_INFLIGHT_REQUESTS=32
INTEGRATION_BODY_TIMEOUT_SECONDS=15
INTEGRATION_MAX_TOKENS=50
INTEGRATION_MAX_ENDPOINTS=20
INTEGRATION_REPLAY_HOURS=24
INTEGRATION_RETENTION_DAYS=30
INTEGRATION_MAX_PENDING_REQUESTS=100
INTEGRATION_MAX_REQUEST_BYTES=16777216
INTEGRATION_MAX_RESPONSE_BYTES=2097152
INTEGRATION_WEBHOOK_TIMEOUT_SECONDS=10
INTEGRATION_WEBHOOK_BATCH_SIZE=5
INTEGRATION_WEBHOOK_MAX_ATTEMPTS=8
