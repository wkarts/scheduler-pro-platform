{
  "name": "@scheduler-pro/mobile",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "echo lint-ok",
    "tauri": "tauri",
    "tauri:android:init": "tauri android init",
    "tauri:android:build": "tauri android build --features mobile",
    "tauri:android:apk": "tauri android build --features mobile --apk",
    "tauri:android:apk:debug": "tauri android build --features mobile --apk --debug",
    "tauri:android:aab": "tauri android build --features mobile --aab",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:build": "tauri ios build --features mobile"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "pinia": "2.3.1",
    "vue": "3.5.13",
    "vue-router": "4.4.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "5.2.1",
    "typescript": "5.5.4",
    "vite": "5.4.11",
    "vue-tsc": "2.1.10"
  }
}
