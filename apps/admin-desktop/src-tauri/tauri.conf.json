{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scheduler Pro Admin",
  "version": "2.0.1",
  "identifier": "br.com.argws.schedulerpro.admin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": [
      "desktop"
    ],
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scheduler Pro Admin",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "deb"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "ARGWS Sistemas",
    "category": "Business",
    "shortDescription": "Scheduler Pro Admin",
    "longDescription": "Aplicativo desktop administrativo local do Control Plane Scheduler Pro."
  }
}
