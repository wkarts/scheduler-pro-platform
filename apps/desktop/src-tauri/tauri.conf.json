{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scheduler Pro Desktop",
  "version": "0.1.0-alpha.1",
  "identifier": "br.com.schedulerpro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"Scheduler Pro Desktop","width":1440,"height":900,"minWidth":1100,"minHeight":720,"resizable":true}],
    "security": {"csp":"default-src 'self'; img-src 'self' data: https:; connect-src 'self' http://localhost:* https:; style-src 'self' 'unsafe-inline'; script-src 'self'"}
  },
  "bundle": {"active": false, "targets": "all"}
}
