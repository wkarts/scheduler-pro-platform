{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scheduler Pro Desktop",
  "version": "0.1.0-alpha.1",
  "identifier": "br.com.argws.schedulerpro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "features": ["desktop"],
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "Scheduler Pro Desktop", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 720, "resizable": true, "maximized": true, "visible": true, "center": true}],
    "security": {"csp": null}
  },
  "bundle": {"active": false, "targets": "all"}
}
