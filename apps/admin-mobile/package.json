{
  "name": "@scheduler-pro/admin-mobile",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5177",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "tauri:android:init": "tauri android init",
    "tauri:android:apk": "tauri android build --features mobile --target aarch64 --apk --debug --ci",
    "tauri:android:apk:debug": "tauri android build --features mobile --target aarch64 --apk --debug --ci",
    "tauri:android:apk:release": "tauri android build --features mobile --target aarch64 --apk --ci",
    "tauri:android:aab": "tauri android build --features mobile --target aarch64 --aab --ci",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:build": "tauri ios build --features mobile"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "pinia": "2.3.1",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "5.2.1",
    "typescript": "5.5.4",
    "vite": "5.4.11",
    "vue-tsc": "2.1.10"
  }
}
